#include <stdio.h>
#include <fcntl.h>
#include <unistd.h>
#include <string.h>
int main()
{
    int fd;
    char data[100];
    char buffer[100];
    int n;
    printf("Enter text to write into the file: ");
    fgets(data, sizeof(data), stdin);
    fd = open("/tmp/sample.txt", O_CREAT | O_RDWR | O_TRUNC, 0644);
    if (fd < 0)
    {
        perror("open");
        return 1;
    }
    if (write(fd, data, strlen(data)) < 0)
    {
        perror("write");
        close(fd);
        return 1;
    }
    printf("\nData written successfully.\n");
    lseek(fd, 0, SEEK_SET);
    n = read(fd, buffer, sizeof(buffer) - 1);
    if (n < 0)
    {
        perror("read");
        close(fd);
        return 1;
    }
    buffer[n] = '\0';
    printf("Data read from file: %s", buffer);
    close(fd);
    printf("\nFile closed successfully.\n");
    return 0;
}


INPUT :

Enter text to write into the file: Operating System Lab


OUTPUT :

Data written successfully.
Data read from file: Operating System Lab
File closed successfully.
