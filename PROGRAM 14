#include <stdio.h>
#include <string.h>
#define MAX 20
#define NAME 50
int main()
{
    char files[MAX][NAME];
    int count = 0;
    int choice, i, found;
    char filename[NAME];
    while (1)
    {
        printf("\n--- SINGLE LEVEL DIRECTORY ---\n");
        printf("1. Create File\n");
        printf("2. Display Files\n");
        printf("3. Search File\n");
        printf("4. Delete File\n");
        printf("5. Exit\n");
        printf("Enter your choice: ");
        scanf("%d", &choice);
        switch (choice)
        {
            case 1:
                if (count == MAX)
                {
                    printf("Directory is full.\n");
                    break;
                }
                printf("Enter file name: ");
                scanf("%s", filename);
                found = 0;
                for (i = 0; i < count; i++)
                {
                    if (strcmp(files[i], filename) == 0)
                    {
                        found = 1;
                        break;
                    }
                }
                if (found)
                {
                    printf("File already exists.\n");
                }
                else
                {
                    strcpy(files[count], filename);
                    count++;
                    printf("File created successfully.\n");
                }
                break;
            case 2:
                if (count == 0)
                {
                    printf("Directory is empty.\n");
                }
                else
                {
                    printf("\nFiles in Directory:\n");
                    for (i = 0; i < count; i++)
                    {
                        printf("%d. %s\n", i + 1, files[i]);
                    }
                }
                break;
            case 3:
                printf("Enter file name to search: ");
                scanf("%s", filename);
                found = 0;
                for (i = 0; i < count; i++)
                {
                    if (strcmp(files[i], filename) == 0)
                    {
                        found = 1;
                        break;
                    }
                }
                if (found)
                    printf("File '%s' found in directory.\n", filename);
                else
                    printf("File '%s' not found.\n", filename);
                break;
            case 4:
                printf("Enter file name to delete: ");
                scanf("%s", filename);
                found = 0;
                for (i = 0; i < count; i++)
                {
                    if (strcmp(files[i], filename) == 0)
                    {
                        found = 1;
                        for (; i < count - 1; i++)
                        {
                            strcpy(files[i], files[i + 1]);
                        }
                        count--;
                        printf("File deleted successfully.\n");
                        break;
                    }
                }
                if (!found)
                    printf("File not found.\n");
                break;
            case 5:
                printf("Exiting program...\n");
                return 0;
            default:
                printf("Invalid choice.\n");
        }
    }
    return 0;
}



INPUT :

--- SINGLE LEVEL DIRECTORY ---
1. Create File
2. Display Files
3. Search File
4. Delete File
5. Exit
Enter your choice: 1
Enter file name: file1.txt
Enter file name: file2.txt
Enter your choice: 3
Enter file name to search: file1.txt


OUTPUT :

File created successfully.
File created successfully.
File 'file1.txt' found in directory.
